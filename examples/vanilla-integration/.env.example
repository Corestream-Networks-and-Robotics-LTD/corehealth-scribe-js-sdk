# ==============================================================================
# CoreHealth AI Scribe Vanilla Reference Integration — Environment Configuration
# Copy this file to .env and customize before starting the local proxy server.
# ==============================================================================

# CoreHealth Cloud or Hospital Edge Host
# Local CoreHealth instance: http://127.0.0.1:8000
# Production Cloud instance: https://corehealth.corestream.ng
CH_BASE_URL=http://127.0.0.1:8000

# Client Credentials for Partner Developer Sandbox
CH_CLIENT_ID=partner-emr-dev
CH_CLIENT_SECRET=partner_dev_secret_2026

# Local Reference Server Port
PORT=3001

# Default Consultation Parameters
CH_DEFAULT_LOCALE=en-NG
CH_DEFAULT_PATIENT_ID=492
CH_DEFAULT_ENCOUNTER_ID=1017
CH_DEFAULT_CLINICIAN_ID=38

# Token Time-to-Live (Seconds)
CH_TOKEN_TTL=3600
