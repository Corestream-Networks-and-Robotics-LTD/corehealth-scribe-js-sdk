# ==============================================================================
# CoreHealth AI Scribe JavaScript SDK — Environment Configuration
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# CoreHealth Cloud/Edge Base URL (without trailing slash)
# Local development: http://127.0.0.1:8000
# Production: https://corehealth.corestream.ng
CH_BASE_URL=http://127.0.0.1:8000

# Partner EMR API Client Credentials (issued in CoreHealth Admin -> Interoperability -> API Clients)
CH_CLIENT_ID=partner-emr-dev
CH_CLIENT_SECRET=partner_dev_secret_2026

# Local Proxy Server Port
PORT=3001

# Default Consultation Context for Reference Demo
CH_DEFAULT_LOCALE=en-NG
CH_DEFAULT_PATIENT_ID=492
CH_DEFAULT_ENCOUNTER_ID=1017
CH_DEFAULT_CLINICIAN_ID=38

# Token Time-to-Live in Seconds (default 3600 = 1 hour)
CH_TOKEN_TTL=3600
